# ------------------------------------------------------------
# Database (Supabase Postgres)
# ------------------------------------------------------------
# Supabase project settings > Database > Connection string.
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used at runtime.
# DIRECT_URL: direct connection (port 5432) — used by Prisma migrate/introspect.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# Supabase Auth
# ------------------------------------------------------------
# Supabase project settings > API. Newer projects show "publishable" /
# "secret" keys (sb_publishable_.../sb_secret_...) instead of the legacy
# "anon" / "service_role" JWT keys — use whichever your project shows.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[publishable-key]"
# Secret key: server-only, never expose to the client. Not consumed by any
# code yet — reserved for future admin-level operations. Session
# verification currently goes through cookie-based
# supabase.auth.getUser(), not manual JWT decoding, so no JWT
# secret/JWKS URL is needed either.
SUPABASE_SECRET_KEY="[secret-key]"

# ------------------------------------------------------------
# App-level Postgres role used by Prisma at runtime (NOT the Supabase
# `postgres` superuser role — that role has BYPASSRLS and would silently
# skip all RLS policies). Create this role via prisma/rls/001_helper_functions.sql
# and use its credentials in DATABASE_URL/DIRECT_URL above instead of the
# default `postgres` user once RLS is wired up.
# See prisma/rls/README.md for setup steps.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Email (Resend — free tier, 3,000 emails/mo)
# ------------------------------------------------------------
RESEND_API_KEY="[resend-api-key]"
RESEND_FROM_EMAIL="Flowbase <onboarding@resend.dev>"

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

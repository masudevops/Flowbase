generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase: pooled (pgbouncer) vs direct connection
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum MembershipRole {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ModuleKey {
  WIKI
  TIME_TRACKING
  CALENDAR
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
}

enum AuditAction {
  CARD_CREATED
  CARD_UPDATED
  CARD_DELETED
  CARD_MOVED
  CARD_ASSIGNED
  CARD_BLOCKED
  CARD_UNBLOCKED
  COLUMN_CREATED
  COLUMN_UPDATED
  COLUMN_DELETED
  COLUMN_REORDERED
  BOARD_CREATED
  BOARD_DELETED
  MEMBER_INVITED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
}

enum NotificationType {
  CARD_ASSIGNED
  COMMENT
  AUTOMATION
}

/// Only one action exists today (MVP scope matches the exact "when moved
/// to Done, notify assignee" example this feature was requested for) —
/// kept as an enum rather than a hardcoded string so a second action
/// (e.g. move to another column, set priority) is an additive change
/// later, not a schema rewrite.
enum AutomationAction {
  NOTIFY_ASSIGNEE
}

// ------------------------------------------------------------
// TENANT / IDENTITY
// ------------------------------------------------------------

/// The tenant boundary AND the user-facing "workspace" — one model, not two.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // used in URL: /w/[slug]/...
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  boards         Board[]
  columns        Column[]
  cards          Card[]
  cardTypes      CardType[]
  labels         Label[]
  comments       Comment[]
  checklistItems ChecklistItem[]
  auditLogs      AuditLog[]
  moduleSettings WorkspaceModuleSetting[]
  invites        Invite[]
  contacts       Contact[]
  attachments    Attachment[]
  notifications  Notification[]
  automations    Automation[]
  workflowTemplates WorkflowTemplate[]
  cardAssignees  CardAssignee[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]

  @@map("organizations")
}

/// Mirrors Supabase auth.users (id == auth.uid()). Not the source of truth
/// for credentials — created via upsert on first login.
model User {
  id        String   @id // uuid, matches supabase auth.users.id
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        Membership[]
  /// Legacy single-assignee relation — Card.assigneeId is no longer
  /// written to, kept only until existing rows are backfilled and this
  /// column is dropped in a follow-up. See cardAssignments for the
  /// current multi-assignee relation.
  assignedCards      Card[]          @relation("CardAssignee")
  cardAssignments    CardAssignee[]
  comments           Comment[]
  auditLogs          AuditLog[]      @relation("AuditActor")
  checklistItems     ChecklistItem[] @relation("ChecklistCompletedBy")
  attachments        Attachment[]
  notifications      Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")
  workflowTemplates  WorkflowTemplate[]

  @@map("users")
}

/// Many-to-many User <-> Organization, with role. This is the mechanism
/// for "a user can belong to multiple workspaces."
model Membership {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Pending email invites (user may not have a User row yet). Delivered via
/// Resend; token is emailed as an accept-invite link.
model Invite {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  email          String
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(INVITED)
  invitedById    String           @map("invited_by_id")
  token          String           @unique @default(cuid())
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("invites")
}

/// A workspace-scoped person who can be assigned cards without ever
/// having a Kelbara account — e.g. a subcontractor who just gets a
/// phone call, not a login. Deliberately separate from User/Membership:
/// User.id must equal a real Supabase auth UUID, so there's no way to
/// represent an unregistered person as a User. See Card.assigneeContactId.
model Contact {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  email          String?
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Legacy — see Card.assigneeContactId doc comment.
  assignedCards   Card[]         @relation("CardExternalAssignee")
  cardAssignments CardAssignee[]

  @@index([organizationId])
  @@map("contacts")
}

// ------------------------------------------------------------
// MODULE ENABLEMENT (Phase 2 anticipation, intentionally minimal)
// ------------------------------------------------------------

/// Which optional modules are turned on for a workspace. Kanban is
/// always-on and not represented here.
model WorkspaceModuleSetting {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  module         ModuleKey
  enabled        Boolean   @default(false)
  enabledAt      DateTime? @map("enabled_at")
  settings       Json? // module-specific config, e.g. time-tracking rounding rules

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, module])
  @@map("workspace_module_settings")
}

// ------------------------------------------------------------
// BOARD STRUCTURE
// ------------------------------------------------------------

model Board {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?
  /// Legacy/historical label only (IT_DEV | CONSTRUCTION | BLANK, or
  /// null) — kept for boards created before templates became real rows.
  /// New boards set sourceTemplateId instead; this column isn't written
  /// to anymore going forward.
  templateKey      String? @map("template_key")
  /// Which WorkflowTemplate this board was created from, if any.
  /// Nullable and SetNull-on-delete: a board must never disappear or
  /// break just because someone later deletes the template that seeded
  /// it — this is provenance, not a live dependency.
  sourceTemplateId String? @map("source_template_id")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceTemplate WorkflowTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  columns        Column[]
  cards          Card[]
  automations    Automation[]
  cardTypes      CardType[]

  @@index([organizationId])
  @@index([sourceTemplateId])
  @@map("boards")
}

model Column {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id") // denormalized for RLS simplicity
  boardId          String   @map("board_id")
  name             String
  /// Fractional-index string for column ordering (e.g. "a0", "a1", "a1V").
  position         String
  isDoneColumn     Boolean  @default(false) @map("is_done_column") // for dashboard "open tasks" counts
  /// Moving a card into a column with this set auto-flags Card.isBlocked
  /// (user can still manually override/clear).
  isBlockedColumn  Boolean  @default(false) @map("is_blocked_column")
  /// Nullable, unused until inspection/sign-off workflow (Phase 3) ships.
  requiresApproval Boolean  @default(false) @map("requires_approval")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  board        Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards        Card[]
  automations  Automation[]

  @@index([organizationId])
  @@index([boardId])
  @@map("columns")
}

/// Per-board customizable card type (Task/Bug/Feature, or
/// Task/Punch-Item/Inspection, etc). Deliberately a table, not an enum.
/// Board-scoped (not org-scoped) so an org running more than one kind of
/// project doesn't leak one board's vocabulary into another's dropdown —
/// organizationId is kept alongside boardId purely as the usual
/// denormalized-for-RLS-simplicity field, same pattern as Column/Card.
model CardType {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  boardId        String   @map("board_id")
  name           String
  color          String   @default("#6B7280")
  icon           String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  board        Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards        Card[]
  customFieldDefinitions CustomFieldDefinition[]

  @@unique([boardId, name])
  @@index([organizationId])
  @@map("card_types")
}

/// A user-definable field, scoped to one CardType (not the whole board)
/// — a "Bug" type and a "Feature" type on the same board can have
/// different custom fields. v1 field types only: TEXT, NUMBER, SELECT.
model CustomFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  cardTypeId     String          @map("card_type_id")
  name           String
  fieldType      CustomFieldType @map("field_type")
  /// Only meaningful for SELECT — a string array of the admin-defined
  /// options. Left null for TEXT/NUMBER.
  options        Json?
  /// Fractional-index string — fields render in this order, append-only
  /// for v1 (no drag-to-reorder UI yet).
  position       String
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cardType     CardType           @relation(fields: [cardTypeId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@index([cardTypeId])
  @@index([organizationId])
  @@map("custom_field_definitions")
}

/// One card's value for one custom field. Stored as a string regardless
/// of fieldType and parsed/formatted at the UI layer — keeps this table
/// simple instead of a polymorphic-column mess for 3 field types.
model CustomFieldValue {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  cardId            String   @map("card_id")
  fieldDefinitionId String   @map("field_definition_id")
  value             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card            Card                   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition  @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([cardId, fieldDefinitionId])
  @@index([organizationId])
  @@map("custom_field_values")
}

/// A reusable "starter kit" for a new board: a name/description plus a
/// set of columns and card types, applied together when a board is
/// created from it. Org-scoped (not global) so RLS stays the same
/// single-pattern check as every other table — every org gets its own
/// copies of the three built-ins (isBuiltIn: true) seeded at org
/// creation (see organization.service.ts), and can save any board's
/// current setup as a new custom template (isBuiltIn: false) on top of
/// that. Deliberately no versioning, no sharing across orgs, no public
/// marketplace — V1 is "configure once, reuse within your own org."
model WorkflowTemplate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Stable identifier for the three seeded built-ins (IT_DEV |
  /// CONSTRUCTION | GENERAL_PM), null for a user's custom template.
  /// Purely informational — nothing re-reads it to decide behavior.
  key            String?
  name           String
  description    String?
  isBuiltIn      Boolean  @default(false) @map("is_built_in")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  columns      WorkflowTemplateColumn[]
  cardTypes    WorkflowTemplateCardType[]
  boards       Board[]

  @@index([organizationId])
  @@map("workflow_templates")
}

model WorkflowTemplateColumn {
  id              String  @id @default(cuid())
  organizationId  String  @map("organization_id")
  templateId      String  @map("template_id")
  name            String
  /// Plain integer order — unlike Column.position (fractional-index,
  /// drag-reordered live), a template's column order is only ever set
  /// at save time, so there's no reorder-without-resequencing need.
  position        Int
  isDoneColumn    Boolean @default(false) @map("is_done_column")
  isBlockedColumn Boolean @default(false) @map("is_blocked_column")

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([templateId])
  @@map("workflow_template_columns")
}

model WorkflowTemplateCardType {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  templateId     String  @map("template_id")
  name           String
  color          String  @default("#6B7280")
  isDefault      Boolean @default(false) @map("is_default")
  position       Int

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([templateId])
  @@map("workflow_template_card_types")
}

/// Per-organization label palette (free-form, color-coded tags).
model Label {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  color          String   @default("#6B7280")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cardLabels   CardLabel[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("labels")
}

model Card {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  boardId        String  @map("board_id")
  columnId       String  @map("column_id")
  cardTypeId     String? @map("card_type_id")

  title       String
  description String? // markdown
  priority    Priority  @default(MEDIUM)
  /// Nullable — a card with only a dueDate still shows as a single-day
  /// marker on the timeline view, no forced data entry.
  startDate   DateTime? @map("start_date")
  dueDate     DateTime? @map("due_date")

  /// Legacy single-assignee columns — no longer written to as of the
  /// CardAssignee join table (see below). Kept for one release cycle
  /// rather than dropped immediately, same pattern as
  /// Board.templateKey going legacy in the workflow-templates build.
  assigneeId        String? @map("assignee_id")
  assigneeContactId String? @map("assignee_contact_id")
  /// Independent of column: a card in ANY column can be flagged blocked.
  /// Single source of truth for dashboard/filter queries.
  isBlocked         Boolean @default(false) @map("is_blocked")
  blockedReason     String? @map("blocked_reason")
  /// Optional structured "blocked by" reference on top of the freetext
  /// reason above — lets a block point at a real card instead of just a
  /// sentence. onDelete: SetNull so deleting the blocking card doesn't
  /// cascade-delete the card it was blocking (mirrors parentCardId).
  blockedByCardId   String? @map("blocked_by_card_id")

  /// Construction vertical: free-text site/floor/zone tag.
  location String?

  /// Jira-style epic/sub-task link: any card can group other cards on the
  /// same board. Loose by design — no isEpic flag, a card is "an epic"
  /// simply by having children. onDelete: SetNull so deleting a parent
  /// un-parents its children instead of cascading the delete.
  parentCardId String? @map("parent_card_id")

  /// Fractional-index string for ordering within a column.
  position String

  /// Inspection/sign-off (Phase 3): nullable now, unused until that
  /// feature ships — avoids a backfill migration later.
  approverId String?   @map("approver_id")
  approvedAt DateTime? @map("approved_at")

  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String    @map("created_by_id")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  board           Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column          Column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  cardType        CardType?    @relation(fields: [cardTypeId], references: [id], onDelete: SetNull)
  assignee        User?        @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeContact Contact?     @relation("CardExternalAssignee", fields: [assigneeContactId], references: [id], onDelete: SetNull)
  parent          Card?        @relation("CardParent", fields: [parentCardId], references: [id], onDelete: SetNull)
  children        Card[]       @relation("CardParent")
  blockedByCard   Card?        @relation("CardBlockedBy", fields: [blockedByCardId], references: [id], onDelete: SetNull)
  blocking        Card[]       @relation("CardBlockedBy")

  labels         CardLabel[]
  comments       Comment[]
  checklistItems ChecklistItem[]
  auditLogs      AuditLog[]
  attachments    Attachment[]
  notifications  Notification[]
  assignees      CardAssignee[]
  customFieldValues CustomFieldValue[]

  @@index([organizationId])
  @@index([boardId])
  @@index([columnId])
  @@index([assigneeId])
  @@index([assigneeContactId])
  @@index([parentCardId])
  @@index([blockedByCardId])
  @@index([organizationId, isBlocked])
  @@index([organizationId, dueDate])
  @@map("cards")
}

/// A card can now have several assignees — a row here means "this user
/// OR this contact is assigned," mirroring the never-both rule the
/// legacy Card.assigneeId/assigneeContactId columns used to enforce
/// (still service-layer only, not a DB CHECK constraint, consistent
/// with how that rule already worked). The two @@unique constraints
/// prevent assigning the same user (or the same contact) to a card
/// twice; Postgres treats each NULL as distinct, so they don't collide
/// with each other.
model CardAssignee {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  cardId         String   @map("card_id")
  userId         String?  @map("user_id")
  contactId      String?  @map("contact_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@unique([cardId, contactId])
  @@index([organizationId])
  @@index([cardId])
  @@map("card_assignees")
}

model CardLabel {
  cardId  String @map("card_id")
  labelId String @map("label_id")

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}

model Comment {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  cardId         String    @map("card_id")
  authorId       String    @map("author_id")
  body           String // markdown
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  editedAt       DateTime? @map("edited_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([cardId])
  @@map("comments")
}

model ChecklistItem {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  cardId         String    @map("card_id")
  text           String
  isDone         Boolean   @default(false) @map("is_done")
  position       String // fractional index within the card's checklist
  completedById  String?   @map("completed_by_id")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  completedBy  User?        @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([cardId])
  @@map("checklist_items")
}

/// Metadata for a file in Supabase Storage's private `attachments`
/// bucket. The actual bytes never pass through our server — the browser
/// uploads directly to Storage (governed by storage.objects RLS, see
/// prisma/rls/004_storage.sql), then calls attachment.create with the
/// resulting path. storagePath follows `{organizationId}/{cardId}/{cuid}-{fileName}`
/// — the leading organizationId segment is what the storage policies key
/// tenant isolation off of.
model Attachment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  cardId         String   @map("card_id")
  uploadedById   String   @map("uploaded_by_id")
  fileName       String   @map("file_name")
  storagePath    String   @map("storage_path")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([cardId])
  @@map("attachments")
}

// ------------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------------

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  actorId        String?     @map("actor_id") // null if system-generated
  action         AuditAction
  entityType     String      @map("entity_type") // "card" | "column" | "board" | "membership"
  entityId       String      @map("entity_id")
  cardId         String?     @map("card_id") // convenience FK for fast per-card history queries
  metadata       Json? // structured diff, e.g. { field, from, to }
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  card         Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([cardId])
  @@map("audit_logs")
}

// ------------------------------------------------------------
// ACTIVITY FEED
// ------------------------------------------------------------

/// The in-app equivalent of the emails notification.service.ts already
/// sends (card assigned, new comment) — written alongside those, not
/// instead of them, so the two never drift into inconsistent triggers.
model Notification {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id") // recipient
  type           NotificationType
  cardId         String?          @map("card_id")
  actorId        String?          @map("actor_id") // null if system-generated (e.g. an automation)
  message        String
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  card         Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  actor        User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId, readAt])
  @@map("notifications")
}

// ------------------------------------------------------------
// AUTOMATIONS
// ------------------------------------------------------------

/// MVP scope, matching the exact "when moved to Done, notify assignee"
/// example this was requested for: one trigger shape (a card entering a
/// specific column) and one action (AutomationAction). No generic
/// trigger/condition DSL — that's real scope for a feature nobody asked
/// for yet.
model Automation {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  boardId         String           @map("board_id")
  name            String
  triggerColumnId String           @map("trigger_column_id")
  action          AutomationAction @default(NOTIFY_ASSIGNEE)
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  board         Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  triggerColumn Column       @relation(fields: [triggerColumnId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([boardId])
  @@index([triggerColumnId])
  @@map("automations")
}

// Future module content models (WikiPage, TimeEntry, Sprint) are NOT
// modeled yet — adding them later is a purely additive migration,
// nothing above needs to change to support them.
